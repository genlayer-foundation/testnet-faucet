# Faucet wallet (must hold native GEN on the target rollup, including gas)
# Expected address: 0x08E9F4723CF5A27866bB11eD2C41162e05206777
FAUCET_PRIVATE_KEY=0x...

# Server RPC override (optional; defaults to NEXT_PUBLIC_RPC_URL)
RPC_URL=https://rpc-genlayer-chain-testnet-cfn8m3xc6l.t.conduit.xyz

# Cloudflare Turnstile (get from https://dash.cloudflare.com > Turnstile)
# Test keys that always pass:
#   Site key: 1x00000000000000000000AA
#   Secret:   1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis — keep existing credentials to carry over cooldowns and statistics
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Required public network config (set before building; never include RPC credentials)
NEXT_PUBLIC_CHAIN_NAME="GenLayer Bradbury Phase 2"
NEXT_PUBLIC_RPC_URL=https://rpc-genlayer-chain-testnet-cfn8m3xc6l.t.conduit.xyz
NEXT_PUBLIC_EXPLORER_URL=https://explorer-genlayer-chain-testnet-cfn8m3xc6l.t.conduit.xyz
NEXT_PUBLIC_CHAIN_ID=4221

# Faucet settings
CLAIM_AMOUNT=100
BALANCE_THRESHOLD=1000
NEXT_PUBLIC_CLAIM_AMOUNT=100
# Global daily claim cap — bounds worst-case daily loss regardless of sybil sophistication
MAX_CLAIMS_PER_DAY=150

# Mainnet ETH balance requirement (anti-sybil)
ETHEREUM_RPC_URL=https://cloudflare-eth.com
MIN_ETH_BALANCE=0.01
NEXT_PUBLIC_MIN_ETH_BALANCE=0.01

# One-time validator grant: a wallet holding at least VALIDATOR_GRANT_MIN_ETH
# on Ethereum MAINNET can claim VALIDATOR_GRANT_AMOUNT GEN once, forever
# (once per wallet and once per GitHub account). Off unless
# VALIDATOR_GRANT_ENABLED=true and ETHEREUM_RPC_URL is set; rebuild after changing.
VALIDATOR_GRANT_ENABLED=false
VALIDATOR_GRANT_AMOUNT=50000
VALIDATOR_GRANT_MIN_ETH=1
# Max validator grants per UTC day, all wallets together. 0 switches it off.
VALIDATOR_GRANT_DAILY_CAP=100
# Optional anti-farming extras (both off by default):
# minimum transactions the wallet has sent on mainnet
VALIDATOR_GRANT_MIN_TX_COUNT=0
# "latest" or "finalized": which mainnet block the balance is read at
VALIDATOR_GRANT_BALANCE_BLOCK=latest

# App URL (for metadata)
NEXT_PUBLIC_APP_URL=https://testnet-faucet.genlayer.foundation

# Allowed hostname for Turnstile validation (falls back to parsing NEXT_PUBLIC_APP_URL)
# ALLOWED_HOSTNAME=testnet-faucet.genlayer.foundation

# Auth.js (GitHub OAuth)
AUTH_SECRET=  # Generate with: npx auth secret
AUTH_GITHUB_ID=  # GitHub OAuth App Client ID
AUTH_GITHUB_SECRET=  # GitHub OAuth App Client Secret
